# Base URL of the deployed Django/DRF backend (no trailing slash; the client
# appends /api automatically).
VITE_API_URL=https://veltrix-backend-5cwa.onrender.com

# Accepted alias for VITE_API_URL (either may be used).
VITE_API_BASE_URL=https://veltrix-backend-5cwa.onrender.com

# Backend URL used by the Vite dev-server proxy (dev only).
VITE_BACKEND_URL=https://veltrix-backend-5cwa.onrender.com

# Optional. Only set this if a real WebSocket/Channels endpoint is deployed.
# Leave empty: the backend in this repository does not expose WebSocket routes.
VITE_WS_URL=

# Optional support link shown in the live-chat panel.
VITE_TELEGRAM_LINK=https://t.me/your-link

# Optional. Simulated (demo) funding switch — off unless explicitly "1"/"true".
# Dev/test only: `vite build` sets import.meta.env.PROD, so production bundles
# never include the demo top-up entry points regardless of this value. The
# Django backend still enforces FUNDING_DEMO_TOPUP_ENABLED independently.
VITE_DEMO_TOPUP_ENABLED=
